        "jsCode": "// 1. 獲取前一個節點（Google Sheets）輸出的所有資料\nconst items = $input.all();\n\n// 2. 建立一個陣列來存放處理後的結果\nlet result = [];\n\nfor (let item of items) {\n  // 檢查資料裡面有沒有「工作」這一欄，且內容不為空\n  if (item.json.工作 && item.json.工作.trim() !== \"\") {\n    result.push({\n      json: {\n        // 這裡可以自訂你想傳給下一個 AI 節點的欄位名稱\n        topic: \"工作\",\n        content: item.json.工作,\n        row_number: item.json.row_number\n      }\n    });\n  }\n}\n\n// 3. 回傳處理後的資料給下一個節點\nreturn result;"
      },
