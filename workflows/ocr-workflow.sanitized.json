    },
    {
      "parameters": {
        "jsCode": "let rawText = '未接收到 AI 筆記內容';\n\n// 嘗試抓取 AI Agent2 (圖片) 的輸出\ntry {\n  const agent2Output = $('A3. 整理圖片辨識結果').item?.json?.output;\n  if (agent2Output) rawText = agent2Output;\n} catch (e) {\n  // 如果 AI Agent2 沒執行，會進入這裡，我們就忽略錯誤往下走\n}\n\n// 嘗試抓取 AI Agent3 (PDF) 的輸出\ntry {\n  const agent3Output = $('B3. 整理 PDF 辨識結果').item?.json?.output;\n  if (agent3Output) rawText = agent3Output;\n} catch (e) {\n  // 如果 AI Agent3 沒執行，同樣忽略\n}\n\n// 將 Markdown 的 ** 粗體轉為 HTML <strong>\n// 將 Markdown 的 * 項目符號轉為 HTML <li>\nlet htmlText = rawText\n  .replace(/\\*\\*(.*?)\\*\\*/g, '<strong>$1</strong>')\n  .replace(/^\\*\\s(.*)$/gm, '<li>$1</li>')\n  .replace(/\\n/g, '<br>'); // 把換行變成 HTML 換行\n\nreturn { htmlText };"
      },
